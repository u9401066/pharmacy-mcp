# Stable agent output
PHARMACY_MCP_DEFAULT_OUTPUT_FORMAT=json
PHARMACY_MCP_DEFAULT_LOCALE=zh-TW

# Taiwan NHI monthly official dataset
PHARMACY_MCP_NHI_AUTO_DOWNLOAD=true
PHARMACY_MCP_NHI_INDEX_PATH=.cache/nhi/drug-items.sqlite3
PHARMACY_MCP_NHI_REFRESH_DAYS=7

# Hospital FHIR (adapter registers only when BASE_URL is set)
PHARMACY_MCP_FHIR_BASE_URL=https://hospital.example/fhir
PHARMACY_MCP_FHIR_BEARER_TOKEN=replace-with-short-lived-token
PHARMACY_MCP_FHIR_VERSION=R4
PHARMACY_MCP_FHIR_VERIFY_TLS=true
PHARMACY_MCP_FHIR_MEDICATION_RESOURCES=MedicationKnowledge,Medication
PHARMACY_MCP_FHIR_INVENTORY_RESOURCES=InventoryItem,InventoryReport,SupplyDelivery

# Organization files (comma-separated operator-controlled roots)
PHARMACY_MCP_FILE_ROOTS=knowledge
PHARMACY_MCP_FILE_MAX_BYTES=20971520
PHARMACY_MCP_FILE_MAX_FILES=500

# Read-only SQLite with an explicit table/column projection
PHARMACY_MCP_SQL_DATABASE_PATH=/srv/pharmacy/formulary.sqlite3
PHARMACY_MCP_SQL_TABLES=[{"table":"medications","search_columns":["code","name","ingredient"],"output_columns":["code","name","ingredient","stock"]}]

# Organization vector-search gateway
PHARMACY_MCP_VECTOR_SEARCH_URL=https://vector.internal.example/search
PHARMACY_MCP_VECTOR_API_KEY=replace-with-short-lived-service-token
PHARMACY_MCP_VECTOR_VERIFY_TLS=true

# Fixed, credential-free HTTPS pages (JSON array; no caller-supplied URLs)
PHARMACY_MCP_WEB_URLS=["https://hospital.example/pharmacy/bulletins.html"]
PHARMACY_MCP_WEB_MAX_BYTES=2097152
